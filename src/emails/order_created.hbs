{{> _header}}

<div style="max-width:600px;margin:0 auto;font-family: -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#222">
  <div style="padding:24px;background:#ffffff;border-radius:8px;">
    <h1 style="font-size:20px;margin:0 0 8px;color:#111">Thanks for your order, {{customerName}} 👋</h1>
    <p style="margin:0 0 18px;color:#555">We've received your order <strong>#{{id}}</strong>. A PDF invoice is attached to this email.</p>

    <table role="presentation" style="width:100%;border-collapse:collapse;margin-bottom:16px">
      <thead>
        <tr>
          <th align="left" style="border-bottom:1px solid #eee;padding:8px 0">Item</th>
          <th align="center" style="border-bottom:1px solid #eee;padding:8px 0">Qty</th>
          <th align="right" style="border-bottom:1px solid #eee;padding:8px 0">Price</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td style="padding:10px 0;border-bottom:1px dashed #f0f0f0">{{this.title}}</td>
          <td align="center" style="padding:10px 0;border-bottom:1px dashed #f0f0f0">{{this.quantity}}</td>
          <td align="right" style="padding:10px 0;border-bottom:1px dashed #f0f0f0">₹{{this.price}}</td>
        </tr>
        {{/each}}
      </tbody>
      <tfoot>
        <tr>
          <td></td>
          <td style="padding:12px 0;font-weight:600">Total</td>
          <td align="right" style="padding:12px 0;font-weight:700">₹{{total}}</td>
        </tr>
      </tfoot>
    </table>

    <p style="margin:0 0 8px;color:#666">Shipping to:</p>
    <p style="margin:0 0 18px;color:#333;font-size:14px;line-height:1.4">
      {{shippingName}}<br/>
      {{shippingAddressLine1}} {{#if shippingAddressLine2}}<br/>{{shippingAddressLine2}}{{/if}}<br/>
      {{shippingCity}} {{shippingPostcode}}<br/>
      {{shippingState}} {{shippingCountry}}
    </p>

    <p style="margin:0;color:#444">If you have any questions, reply to this email and we'll help.</p>
  </div>

  <p style="text-align:center;color:#999;font-size:12px;margin:12px 0 0">Order placed on {{createdAt}}</p>
</div>

{{> _footer}}
