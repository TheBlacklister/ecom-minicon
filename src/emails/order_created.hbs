{{> _header}}

<div style="max-width:600px;margin:0 auto;font-family:system-ui,Arial,sans-serif;color:#222;">
  <div style="padding:24px;background:#fff;border-radius:0 0 8px 8px;">

    <h1 style="margin:0 0 8px;">Order Confirmed 🎉</h1>

    <p>Hi {{customerName}},</p>

    <p>Your order <strong>#{{id}}</strong> has been successfully placed.</p>

    <table width="100%" style="border-collapse:collapse;margin:16px 0;">
      <thead>
        <tr>
          <th align="left">Item</th>
          <th align="center">Qty</th>
          <th align="right">Price</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>
            {{this.title}}
            {{#if this.size}}<br/><small>Size: {{this.size}}</small>{{/if}}
          </td>
          <td align="center">{{this.quantity}}</td>
          <td align="right">₹{{this.price}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <p><strong>Total: ₹{{total}}</strong></p>

    {{#if trackingLink}}
      <p>
        Track your order:
        <a href="{{trackingLink}}">Track Order</a>
      </p>
    {{else}}
      <p>Tracking details will be shared once shipped.</p>
    {{/if}}

    <h3>Shipping Address</h3>
    <p style="line-height:1.5;">
      {{shippingName}}<br/>
      {{shippingAddressLine1}}<br/>
      {{#if shippingAddressLine2}}{{shippingAddressLine2}}<br/>{{/if}}
      {{shippingCity}} - {{shippingPostcode}}<br/>
      {{shippingState}}, {{shippingCountry}}
    </p>

    <p>If you have any questions, just reply to this email.</p>

  </div>

  <p style="text-align:center;font-size:12px;color:#999;">
    Order placed on {{createdAt}}
  </p>
</div>

{{> _footer}}