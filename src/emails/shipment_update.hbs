{{> _header}}

<div style="max-width:600px;margin:0 auto;font-family:system-ui,Arial,sans-serif;color:#222;">
  <div style="padding:24px;background:#fff;border-radius:0 0 8px 8px;">

    <h2>Your Order Has Shipped 🚚</h2>

    <p>Hi {{customerName}},</p>

    <p>Your order <strong>#{{id}}</strong> is on its way!</p>

    <div style="margin:16px 0;padding:12px;background:#f7f7f7;border-radius:6px;">
      <p><strong>Tracking ID:</strong> {{tracking}}</p>
      <p><strong>Courier:</strong> {{carrier}}</p>
      <p><strong>Estimated Delivery:</strong> {{eta}}</p>
    </div>

    <a href="{{trackingLink}}" 
       style="display:inline-block;margin-top:12px;padding:12px 20px;background:#111;color:#fff;text-decoration:none;border-radius:6px;">
       Track Your Order
    </a>

    <p style="margin-top:20px;">We’ll notify you once it’s delivered.</p>

  </div>

  <p style="text-align:center;font-size:12px;color:#999;">
    Order placed on {{createdAt}}
  </p>
</div>

{{> _footer}}