<!doctype html>
<html>
  <body style="font-family:system-ui,Arial,sans-serif;color:#222;">
    <h2>Invoice – Order #{{id}}</h2>

    <p>Hi {{customerName}},</p>
    <p>Thank you for your purchase. Please find your order details below:</p>

    <table width="100%" style="border-collapse:collapse;margin-top:16px;">
      <thead>
        <tr>
          <th align="left">Item</th>
          <th align="center">Qty</th>
          <th align="right">Price</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{this.title}}</td>
          <td align="center">{{this.quantity}}</td>
          <td align="right">₹{{this.price}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <p style="margin-top:16px;"><strong>Total: ₹{{total}}</strong></p>

    <p>We’ll notify you once your order is shipped.</p>

    <p style="margin-top:24px;">— MINICON</p>
  </body>
</html>